# Copy this file to .env and replace the example address with smallboi's
# reserved/static IPv4 address on your home LAN.
SERVER_LAN_IP=192.168.1.123

# Homepage runs as the same unprivileged user that owns the repository.
PUID=1000
PGID=1000

# Ollama runs on the Mac and remains bound to loopback. Tailscale Serve exposes
# it privately to the tailnet at this URL.
OLLAMA_BASE_URL=https://madmans-macbook.arowana-cat.ts.net

# Generate with: openssl rand -hex 32
OPEN_WEBUI_SECRET_KEY=replace-with-a-random-64-character-hex-string
