#!/usr/bin/env bash

set -euo pipefail

if ! command -v tailscale >/dev/null 2>&1; then
	printf 'tailscale is not installed or is not on PATH.\n' >&2
	exit 1
fi

if ! tailscale status >/dev/null 2>&1; then
	printf 'Tailscale is not connected. Run sudo tailscale up first.\n' >&2
	exit 1
fi

configure_service() {
	local name="$1"
	local target="$2"

	printf 'Configuring https://%s.arowana-cat.ts.net -> %s\n' "$name" "$target"
	if ! tailscale serve --yes --service="svc:${name}" --https=443 "$target"; then
		printf 'Check that smallboi is tagged, svc:%s is defined with tcp:443, and this host is approved. See COMMANDS.md.\n' "$name" >&2
		return 1
	fi
}

configure_service home http://127.0.0.1:3000
configure_service pdf http://127.0.0.1:6000
configure_service qbit http://127.0.0.1:4000
configure_service torrent http://127.0.0.1:5000
configure_service jellyfin http://127.0.0.1:8096
configure_service portainer http://127.0.0.1:9000
configure_service cockpit https+insecure://127.0.0.1:9090

printf '\nTailscale Services configured. Approve any pending service hosts in the admin console.\n'
