#!/usr/bin/env bash

set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
	printf 'Run with sudo: sudo %s\n' "$0" >&2
	exit 1
fi

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="${repo_dir}/compose.yaml"
server_source="${repo_dir}/scripts/ssd-recovery-server.py"
server_target=/usr/local/libexec/homelab-ssd-recovery-server.py
unit_target=/etc/systemd/system/homelab-ssd-recovery.service

if [[ ! -f "${compose_file}" ]]; then
	printf 'Compose file not found: %s\n' "${compose_file}" >&2
	exit 1
fi

install -d -o root -g root -m 0755 /usr/local/libexec
install -o root -g root -m 0755 "${server_source}" "${server_target}"

cat >"${unit_target}" <<EOF
[Unit]
Description=Homepage external SSD recovery button
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
Environment=HOMELAB_DIR=${repo_dir}
ExecStart=/usr/bin/python3 ${server_target}
Restart=on-failure
RestartSec=3
User=root
Group=root
UMask=0077

[Install]
WantedBy=multi-user.target
EOF

chmod 0644 "${unit_target}"
systemctl daemon-reload
systemctl enable --now homelab-ssd-recovery.service

printf 'Installed and started homelab-ssd-recovery.service\n'
printf 'The web control listens only on 127.0.0.1:3101; Tailscale Serve provides HTTPS access.\n'
